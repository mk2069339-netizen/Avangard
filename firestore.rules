rules_version = '2';

// Avangard — Firestore xavfsizlik qoidalari.
// Xodimlar: admin@avangard.app (Admin) va boshliq@avangard.app (Boshliq).
// Hisoblar Firebase Console → Authentication'da yaratiladi (Email/Password).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInWithPassword() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isBoss() {
      return signedInWithPassword() && request.auth.token.email == 'boshliq@avangard.app';
    }
    function isStaff() {
      return isBoss()
        || (signedInWithPassword() && request.auth.token.email == 'admin@avangard.app');
    }

    // Mahsulotlar: hamma ko'radi, faqat xodimlar o'zgartiradi.
    // Mijoz buyurtma berganda faqat qoldiq (stock) kamayishi va sotuvlar (orders) oshishiga ruxsat.
    match /products/{id} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'orders'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && request.resource.data.orders > resource.data.orders
      );
    }

    // Buyurtmalar: mijoz yaratadi va o'zinikini ID orqali ko'radi (ID uzun va tasodifiy).
    // Ro'yxatni ko'rish va holatni o'zgartirish — faqat xodimlar.
    match /orders/{id} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if request.resource.data.status == 'Yangi'
        && request.resource.data.id == id
        && request.resource.data.total is number
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.customer is string
        && request.resource.data.phone is string;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // Xodimlar harakatlari jurnali.
    match /logs/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.who in ['admin', 'boshliq'];
      allow delete: if isBoss();
      allow update: if false;
    }

    // Eski sozlamalar (PIN parollar) endi ishlatilmaydi.
    match /settings/{id} {
      allow read, write: if false;
    }
  }
}
